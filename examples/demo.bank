# libZFork2 SoundBank V1 — Beispiel-Bankdatei
#
# Format (semikolon-getrennt, eine Zeile pro Event):
#   eventId ; path ; group ; type ; volume ; pan ; priority ; loop
#
# Felder:
#   eventId   Eindeutiger Name mit dem zfork2_PlayEventV1 aufgerufen wird
#   path      Pfad zur Audiodatei (absolut ODER relativ zum Verzeichnis dieser .bank-Datei)
#   group     Gruppenname: master | music | sfx | ui  (oder eigene registrierte Gruppe)
#   type      predecoded   — wird komplett in RAM geladen (kurze Sounds, SFX)
#             streaming    — wird von Disk gestreamt (lange Musik-Tracks)
#   volume    0.0 – 1.0  (Standard: 1.0)
#   pan       -1.0 (links) – 0.0 (Mitte) – +1.0 (rechts)  (Standard: 0.0)
#   priority  Ganze Zahl, höher = wird beim Voice-Stealing bevorzugt behalten
#   loop      0 = kein Loop  |  -1 = endlos  |  N = N weitere Wiederholungen

# ── UI-Sounds (kurze Klicks, immer predecoded) ──────────────────────────────
ui_click       ; sounds/ui/click.wav      ; ui  ; predecoded ; 0.8 ; 0.0 ; 10 ; 0
ui_confirm     ; sounds/ui/confirm.wav    ; ui  ; predecoded ; 0.8 ; 0.0 ; 10 ; 0
ui_back        ; sounds/ui/back.wav       ; ui  ; predecoded ; 0.7 ; 0.0 ;  8 ; 0
ui_error       ; sounds/ui/error.wav      ; ui  ; predecoded ; 0.9 ; 0.0 ; 12 ; 0

# ── SFX (Gameplay-Effekte) ──────────────────────────────────────────────────
sfx_explosion  ; sounds/sfx/explosion.wav ; sfx ; predecoded ; 1.0 ; 0.0 ; 5 ; 0
sfx_shot       ; sounds/sfx/shot.wav      ; sfx ; predecoded ; 0.9 ; 0.0 ; 5 ; 0
sfx_pickup     ; sounds/sfx/pickup.wav    ; sfx ; predecoded ; 0.8 ; 0.0 ; 3 ; 0
sfx_jump       ; sounds/sfx/jump.wav      ; sfx ; predecoded ; 0.7 ; 0.0 ; 3 ; 0

# ── Musik (gestreamt, endlos geloopt) ───────────────────────────────────────
music_menu     ; music/menu_theme.ogg     ; music ; streaming ; 0.6 ; 0.0 ; 0 ; -1
music_ingame   ; music/ingame_loop.ogg    ; music ; streaming ; 0.7 ; 0.0 ; 0 ; -1
music_boss     ; music/boss_fight.ogg     ; music ; streaming ; 0.8 ; 0.0 ; 0 ; -1
